# [HMI v2] ── 프론트엔드 환경변수 (Vite는 VITE_ 접두사만 클라이언트에 노출) ──

# 목(mock) 모드: true면 백엔드 없이 src/lib/mock 데이터로 동작한다.
# 백엔드 통합 전에는 true로 개발한다.
VITE_MOCK=true

# 실제 백엔드(hmi/backend_v2) REST 베이스 URL (VITE_MOCK=false일 때 사용)
VITE_API_BASE=http://localhost:8001

# 실제 백엔드 WebSocket URL (VITE_MOCK=false일 때 사용)
VITE_WS_URL=ws://localhost:8001/ws/robot/status
